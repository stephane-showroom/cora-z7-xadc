# ==============================================================================
hw/*.jou
hw/*.log
hw/*.str
hw/*.dmp
hw/*.pb
hw/*.wdb
hw/.Xil/
.Xil/

hw/hw.cache/
hw/hw.gen/
hw/hw.runs/
hw/hw.sim/
hw/hw.ip_user_files/
hw/hw.hw/
hw/NA

# ==============================================================================
# Software & Platform Build Outputs (Vitis)
# ==============================================================================
soft/build/
soft/src/.cache/
platform/hw/
platform/sw/
platform/ps7_cortexa9_0/
platform/zynq_fsbl/
platform/logs/

zynq_fsbl/build/
zynq_fsbl/zynq_fsbl_bsp/

